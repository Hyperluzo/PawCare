# PawCare Environment Configuration
# Copy this file to .env and replace with your deployment secrets.
# NEVER commit real credentials to source control.

# --- Environment Mode ---
ASPNETCORE_ENVIRONMENT=Production

# --- Database (PostgreSQL / AWS RDS) ---
# For AWS RDS: Host=<rds-endpoint>.rds.amazonaws.com;Port=5432;Database=pawcare;Username=dbadmin;Password=<db-password>;SslMode=Require;
ConnectionStrings__Default=Host=localhost;Port=5432;Database=pawcare;Username=postgres;Password=<YOUR_DATABASE_PASSWORD>

# Automatic EF Core migration on container startup (useful for zero-downtime EC2 / container deployment)
ApplyMigrationsOnStartup=true
SeedDefaultData=false
EnableSwagger=true

# --- JWT Authentication ---
# Generate a secure 256-bit symmetric key
Jwt__Key=<YOUR_JWT_SECRET_KEY_MIN_32_CHARS>
Jwt__Issuer=pawcare-api
Jwt__Audience=pawcare-clients

# --- AWS Configuration (SES & S3) ---
Aws__Region=us-east-1
Aws__SenderEmail=no-reply@pawcare.local
Aws__SimulationMode=false

# AWS S3 Bucket for Patient Photos & Medical Reports
Aws__S3__BucketName=pawcare-attachments-production
Aws__S3__SimulationMode=false
Aws__S3__MaxFileSizeBytes=10485760

# AWS Credentials (Optional if running on EC2 with IAM Instance Profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Frontend Base URL (Build-time) ---
VITE_API_BASE_URL=http://localhost:8080/api
